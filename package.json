{
  "name": "quick-gateway",
  "private": true,
  "version": "0.1.0",
  "description": "OpenAI- and Anthropic-compatible API gateway for Amazon Quick on Cloudflare Workers (educational project).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "bundle": "wrangler deploy --dry-run --outdir .wrangler/bundle",
    "test": "npm run test:oauth && npm run test:smoke",
    "test:oauth": "node --test scripts/oauth-login.test.mjs",
    "test:smoke": "npm run bundle && node scripts/smoke-test.mjs .wrangler/bundle/index.js",
    "check": "npm run typecheck && npm run build && npm test",
    "worker:dev": "wrangler dev",
    "login": "node scripts/oauth-login.mjs",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.19",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
